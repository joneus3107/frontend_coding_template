{
	"name": "frontend-template-pug",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:assets": "vite build --watch",
		"dev:html": "eleventy --serve --watch",
		"dev": "npm-run-all --parallel dev:assets dev:html",
		"build:assets": "vite build",
		"build:html": "eleventy",
		"build": "npm run build:assets && npm run build:html",
		"images": "node scripts/convert-images.mjs",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-plugin-pug": "^1.0.0",
		"autoprefixer": "^10.4.0",
		"fast-glob": "^3.3.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.0",
		"prettier": "^3.9.6",
		"pug": "^3.0.0",
		"sass": "^1.77.0",
		"sharp": "^0.35.3",
		"vite": "^8.2.1"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.21.5": true,
		"fsevents@2.3.3": true,
		"sharp@0.33.5": true
	}
}
