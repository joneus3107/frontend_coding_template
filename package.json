{
	"name": "frontend-template-pug",
	"version": "1.0.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite build && concurrently --kill-others --names vite,11ty \"vite build --watch\" \"eleventy --serve --watch\"",
		"start": "npm run dev",
		"build": "vite build && eleventy",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-plugin-pug": "^1.0.0",
		"concurrently": "^10.0.6",
		"prettier": "^3.9.6",
		"pug": "^3.0.0",
		"sass": "^1.77.0",
		"vite": "^8.2.1"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.21.5": true,
		"fsevents@2.3.3": true
	}
}
